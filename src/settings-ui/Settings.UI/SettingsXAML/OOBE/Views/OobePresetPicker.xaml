<Page
    x:Class="Microsoft.PowerToys.Settings.UI.OOBE.Views.OobePresetPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.LandmarkType="Main"
    mc:Ignorable="d">

    <!--  [fork-brand] 首启场景推荐：选择场景 → 确认推荐工具 → 应用（可跳过）  -->
    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Orientation="Vertical"
            Spacing="12">

            <TextBlock
                x:Uid="Oobe_PresetPicker_Title"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock
                x:Uid="Oobe_PresetPicker_Description"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <!--  Step 1: 选择场景  -->
            <TextBlock
                x:Uid="Oobe_PresetPicker_Step1_Header"
                AutomationProperties.HeadingLevel="Level2"
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <RadioButtons
                x:Name="ScenarioSelector"
                AutomationProperties.AutomationId="OobePresetScenarioSelector"
                MaxColumns="2"
                SelectionChanged="ScenarioSelector_SelectionChanged" />

            <!--  Step 2: 推荐工具确认  -->
            <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                <TextBlock
                    x:Uid="Oobe_PresetPicker_Step2_Header"
                    AutomationProperties.HeadingLevel="Level2"
                    Margin="0,8,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Uid="Oobe_PresetPicker_RecommendedListText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,4,0,4" />
                <ListView
                    x:Name="RecommendedList"
                    AutomationProperties.AutomationId="OobePresetRecommendedList"
                    IsItemClickEnabled="False"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2" Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!--  Step 3: 应用  -->
            <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                <TextBlock
                    x:Uid="Oobe_PresetPicker_Step3_Header"
                    AutomationProperties.HeadingLevel="Level2"
                    Margin="0,8,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        x:Name="ApplyButton"
                        AutomationProperties.AutomationId="OobePresetApplyButton"
                        Click="ApplyButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        x:Uid="Oobe_PresetPicker_ApplyButton" />
                    <Button
                        x:Name="SkipButton"
                        AutomationProperties.AutomationId="OobePresetSkipButton"
                        Click="SkipButton_Click"
                        x:Uid="Oobe_PresetPicker_SkipButton" />
                </StackPanel>
                <TextBlock
                    x:Uid="Oobe_PresetPicker_SkipHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,8,0,0"
                    TextWrapping="Wrap" />
                <InfoBar
                    x:Name="AppliedInfoBar"
                    AutomationProperties.AutomationId="OobePresetAppliedInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Margin="0,12,0,0"
                    Severity="Success" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

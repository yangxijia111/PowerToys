<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- [fork-identity] fork 代码签名统一配置入口（Binary Preview 阶段未启用）。
       启用方式：ForkCodeSignEnabled 设为 true 并填入证书指纹；签名资产清单与信任链切换点
       见 docs/CODE_SIGNING.md §3/§4。禁止把证书/私钥/密码提交进仓库。 -->
  <PropertyGroup>
    <ForkCodeSignEnabled Condition="'$(ForkCodeSignEnabled)'==''">false</ForkCodeSignEnabled>
    <ForkSignCertThumbprint Condition="'$(ForkSignCertThumbprint)'==''"></ForkSignCertThumbprint>
    <ForkSignTimestampUrl Condition="'$(ForkSignTimestampUrl)'==''">http://timestamp.digicert.com</ForkSignTimestampUrl>
    <!-- 定义为 1 时恢复 pipe 客户端微软签名校验（settings_window.cpp / quick_access_host.cpp） -->
    <ForkPipeRequireMicrosoftSignature Condition="'$(ForkPipeRequireMicrosoftSignature)'==''">0</ForkPipeRequireMicrosoftSignature>
  </PropertyGroup>

  <Target Name="ForkSignReleaseBinaries"
          AfterTargets="Build"
          Condition="'$(ForkCodeSignEnabled)'=='true' and '$(Configuration)'=='Release'">
    <!-- 签名就绪时在此枚举输出目录资产调用 signtool（清单见 docs/CODE_SIGNING.md §3）：
         signtool sign /fd SHA256 /tr $(ForkSignTimestampUrl) /td SHA256 /sha1 $(ForkSignCertThumbprint) <files...>
    -->
    <Warning Text="ForkSigning: ForkCodeSignEnabled=true but no signing steps are implemented yet (docs/CODE_SIGNING.md §4)." />
  </Target>
</Project>
